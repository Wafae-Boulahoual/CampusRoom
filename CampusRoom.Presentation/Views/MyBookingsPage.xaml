<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CampusRoom.Presentation.Views.MyBookingsPage"
             Title="Mina bokningar">

    <Grid RowDefinitions="Auto, *, Auto" RowSpacing="15">

        <Image Grid.RowSpan="3"
           Source="background.png"
           Aspect="AspectFill"
           Opacity="0.4"
           InputTransparent="True"/>

        <VerticalStackLayout Padding="20" Spacing="20">
            <ListView x:Name="BookingsListView"
          ItemsSource="{Binding Bookings}"
          HasUnevenRows="True"
          SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <ViewCell>
                            <Frame Padding="15" Margin="8" BorderColor="CadetBlue" CornerRadius="10" BackgroundColor="White">
                                <HorizontalStackLayout Spacing="15" VerticalOptions="Center">
                                    <VerticalStackLayout Spacing="2" HorizontalOptions="StartAndExpand">
                                        <Label Text="{Binding RoomNumber, StringFormat='Rum {0}'}" 
                                           FontSize="18" 
                                           FontAttributes="Bold" 
                                           TextColor="CadetBlue"/>

                                        <Label Text="{Binding Floor, StringFormat='Våning {0}'}" 
                                           FontSize="14" 
                                           TextColor="Gray"/>
                                        <Label Text="{Binding TimeSlot}" 
                                           FontSize="18" FontAttributes="Bold" 
                                           TextColor="Black"/>
                                        <Label Text="{Binding Date, StringFormat='{0:yyyy-MM-dd}'}" 
                                           FontSize="14" 
                                           TextColor="Gray"/>
                                    </VerticalStackLayout>

                                    <Button Text="Avboka" 
                                        Clicked="OnCancelClicked"
                                        CommandParameter="{Binding .}"
                                        BackgroundColor="Red" 
                                        TextColor="White"
                                        VerticalOptions="Center"
                                        HeightRequest="40"/>
                                </HorizontalStackLayout>
                            </Frame>
                        </ViewCell>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <Button Text="Tillbaka" Clicked="OnBackClicked"/>

        </VerticalStackLayout>
    </Grid>
</ContentPage>